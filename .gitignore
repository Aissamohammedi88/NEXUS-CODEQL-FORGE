# ═══════════════════════════════════════════════════════════════════
# NEXUS CODEQL FORGE — .gitignore
# ═══════════════════════════════════════════════════════════════════

# --- CODEQL ARTIFACTS ---
codeql-database/
*.sarif
results/
*.bqrs

# --- NODE.JS ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# --- PYTHON ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
.pytest_cache/
.coverage
htmlcov/

# --- RUST ---
target/
**/*.rs.bk
Cargo.lock

# --- COBOL ---
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.lib
*.cob~
*.cbl~
*.cpy~
*.lst

# --- OS & EDITORS ---
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
.vs/
*.sublime-workspace
*.sublime-project

# --- LOGS & TEMP ---
*.log
logs/
tmp/
temp/

# --- SECRETS ---
.env
.env.local
*.pem
*.key
*.crt
secrets.json
